<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9 (API 28) and later block plain HTTP by default, so a call to
  http://10.0.2.2:8910 fails before it leaves the device.

  This opens cleartext for local development addresses only:
    10.0.2.2   the host machine, as seen from the Android emulator
    localhost  the device itself
    10.0.3.2   the same thing on Genymotion

  A real backend on the internet must use HTTPS — do not add its domain here.
  To test against a machine on your LAN, add that IP as another <domain>.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
